{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental static inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisMode",
    "semanticResolved",
    "root",
    "counts",
    "projects",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "analysisMode": {
      "const": "static"
    },
    "semanticResolved": {
      "const": false
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "parseStatus",
          "targetDeclarations",
          "workloadHints",
          "references"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "parseStatus": {
            "enum": [
              "parsed",
              "error"
            ]
          },
          "targetDeclarations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workloadHints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
