{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Migration assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "origin",
    "analysisMode",
    "semanticResolved",
    "coverage",
    "projects",
    "findings",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "synthetic-example",
        "application-run"
      ]
    },
    "analysisMode": {
      "enum": [
        "static",
        "semantic"
      ]
    },
    "semanticResolved": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesSeen",
        "filesAnalyzed",
        "limitations"
      ],
      "properties": {
        "filesSeen": {
          "type": "integer",
          "minimum": 0
        },
        "filesAnalyzed": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "language",
          "workload"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "VB",
              "C#",
              "mixed",
              "unknown"
            ]
          },
          "workload": {
            "enum": [
              "library",
              "console",
              "winforms",
              "web",
              "service",
              "mixed",
              "unknown"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "severity",
          "claimType",
          "message",
          "confidence",
          "evidence",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "claimType": {
            "enum": [
              "fact",
              "inference",
              "unknown"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "source",
                    "log",
                    "test-result",
                    "trace",
                    "screenshot",
                    "contract"
                  ]
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysisMode": {
            "const": "static"
          }
        }
      },
      "then": {
        "properties": {
          "semanticResolved": {
            "const": false
          }
        }
      }
    }
  ]
}
