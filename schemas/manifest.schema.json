{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Migration run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "origin",
    "validationLevel",
    "source",
    "targetFramework",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "synthetic-example",
        "application-run"
      ]
    },
    "validationLevel": {
      "enum": [
        "design-only",
        "static-only",
        "build-tested",
        "behavior-tested"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "configuration",
        "platform"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "targetFramework": {
      "enum": [
        "net8.0",
        "net8.0-windows"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "verified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
